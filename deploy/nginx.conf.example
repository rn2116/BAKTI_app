# ==============================================================================
# Nginx Configuration Example for BAKTI App (Next.js PM2 Cluster)
# Balai Bahasa Provinsi Sulawesi Tengah
# ==============================================================================

upstream nextjs_upstream {
    # Port Next.js yang dijalankan oleh PM2 Cluster
    server 127.0.0.1:3000;
    keepalive 64;
}

server {
    listen 80;
    server_name bakti.balai-bahasa-sulteng.id;

    # Redirect seluruh HTTP ke HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name bakti.balai-bahasa-sulteng.id;

    # Sertifikat SSL Let's Encrypt / Certbot
    ssl_certificate /etc/letsencrypt/live/bakti.balai-bahasa-sulteng.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/bakti.balai-bahasa-sulteng.id/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Keamanan & Perlindungan Header Produksi
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;

    # Batas Maksimal Upload Berkas (misal: Excel/Materi/Avatar)
    client_max_body_size 25M;

    # Kompresi Gzip untuk Kecepatan Transfer Jaringan
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types
        text/plain
        text/css
        text/xml
        application/json
        application/javascript
        application/x-javascript
        application/xml
        application/xml+rss
        image/svg+xml;

    # 1. Caching Statis Aset Next.js Bundled (/_next/static/)
    location /_next/static/ {
        alias /var/www/BAKTI_app/.next/static/;
        expires 365d;
        access_log off;
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # 2. Caching File Publik Statis (/public/)
    location ~* \.(ico|jpg|jpeg|png|gif|svg|webp|woff|woff2|ttf|eot)$ {
        root /var/www/BAKTI_app/public;
        expires 30d;
        access_log off;
        add_header Cache-Control "public, max-age=2592000, must-revalidate";
    }

    # 3. Reverse Proxy ke Aplikasi Next.js
    location / {
        proxy_pass http://nextjs_upstream;
        proxy_http_version 1.1;

        # Header Koneksi HTTP & WebSocket
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeout Konfigurasi
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;

        # Buffer Proxy
        proxy_buffering on;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;
    }
}
