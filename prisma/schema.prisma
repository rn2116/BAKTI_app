generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SISWA
  GURU
  ADMIN
  AHLI_BAHASA
}

enum Category {
  BAHASA_INDONESIA
  KARAKTER
  BUDAYA_SULTENG
}

enum QuestionVerificationStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum ExpertVerificationStatus {
  NONE
  PENDING_EXPERT
  APPROVED
  REJECTED
}

model MasterRegency {
  id        String   @id @db.Char(36)
  name      String   @db.VarChar(100)
  code      String   @unique @db.Char(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schools   MasterSchool[]

  @@index([name])
  @@map("master_regencies")
}

model MasterRegionalLanguage {
  id              String   @id @db.Char(36)
  code            String   @unique @db.VarChar(50)
  name            String   @db.VarChar(100)
  regencyCoverage String   @db.VarChar(255) @map("regency_coverage")
  description     String?  @db.Text
  isActive        Boolean  @default(true) @map("is_active")
  createdBy       String?  @db.Char(36) @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  creator         MasterUser? @relation("RegionalLanguageCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([isActive])
  @@index([name])
  @@map("master_regional_languages")
}

model MasterSchool {
  id          String   @id @db.Char(36)
  name        String   @db.VarChar(100)
  npsn        String   @unique @db.Char(8)
  regencyId   String   @db.Char(36)
  address     String   @db.Text
  phone       String   @db.VarChar(20)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  regency     MasterRegency @relation(fields: [regencyId], references: [id], onDelete: Cascade)
  classes     MasterClass[]
  users       MasterUser[]

  @@index([regencyId])
  @@index([name])
  @@map("master_schools")
}

model MasterClass {
  id        String   @id @db.Char(36)
  name      String   @db.VarChar(50)
  grade     Int
  schoolId  String   @db.Char(36)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school    MasterSchool @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users     MasterUser[]

  @@index([schoolId])
  @@index([schoolId, name])
  @@map("master_classes")
}

model MasterUser {
  id                   String                   @id @db.Char(36)
  email                String                   @unique @db.VarChar(255)
  passwordHash         String                   @db.VarChar(255)
  fullName             String                   @db.VarChar(100)
  nisn                 String?                  @unique @db.VarChar(20)
  nip                  String?                  @unique @db.VarChar(20)
  role                 Role                     @default(SISWA)
  schoolId             String?                  @db.Char(36)
  classId              String?                  @db.Char(36)
  domicileRegency      String?                  @db.VarChar(100) @map("domicile_regency")
  participantCategory  String?                  @db.VarChar(60) @map("participant_category")
  institutionName      String?                  @db.VarChar(150) @map("institution_name")
  expertStatus         ExpertVerificationStatus @default(NONE) @map("expert_status")
  expertLanguage       String?                  @db.VarChar(120) @map("expert_language")
  expertAffiliation    String?                  @db.VarChar(150) @map("expert_affiliation")
  expertProofType      String?                  @db.VarChar(100) @map("expert_proof_type")
  expertProofNumber    String?                  @db.VarChar(120) @map("expert_proof_number")
  expertProofFileUrl   String?                  @db.Text @map("expert_proof_file_url")
  expertTrackRecord    String?                  @db.Text @map("expert_track_record")
  expertReviewNotes    String?                  @db.Text @map("expert_review_notes")
  avatarUrl            String?                  @db.Text
  xp                   Int                      @default(0)
  level                Int                      @default(1)
  isActive             Boolean                  @default(true)
  emailVerified        Boolean                  @default(false)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  school                   MasterSchool?            @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  class                    MasterClass?             @relation(fields: [classId], references: [id], onDelete: SetNull)
  materialProgress         UserMaterialProgress[]
  quizAttempts             QuizAttempt[]
  userBadges               UserBadge[]
  certificates             UserCertificate[]
  createdMaterials         LearningMaterial[]       @relation("MaterialCreator")
  createdQuizzes           Quiz[]                   @relation("QuizCreator")
  createdQuestions         QuizQuestion[]           @relation("QuestionCreator")
  verifiedQuestions        QuizQuestion[]           @relation("QuestionVerifier")
  characterMatrices        CharacterMatrix[]
  regionalProgress         RegionalModuleProgress[]
  sertifikatBahasa         Sertifikat[]
  createdRegionalLanguages MasterRegionalLanguage[] @relation("RegionalLanguageCreator")
  notifications            Notification[]

  @@index([role])
  @@index([role, isActive])
  @@index([role, schoolId, isActive])
  @@index([role, expertStatus])
  @@index([expertStatus])
  @@index([schoolId])
  @@index([classId])
  @@index([email])
  @@map("master_users")
}

model Notification {
  id         String   @id @db.Char(36)
  userId     String   @db.Char(36) @map("user_id")
  title      String   @db.VarChar(180)
  message    String   @db.Text
  type       String   @default("system") @db.VarChar(40)
  link       String?  @db.VarChar(255)
  isPriority Boolean  @default(false) @map("is_priority")
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  user MasterUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model LearningMaterial {
  id               String     @id @db.Char(36)
  title            String     @db.VarChar(200)
  slug             String     @unique @db.VarChar(200)
  category         Category
  regionalLanguage String?    @db.VarChar(50) @map("regional_language")
  referenceSource  String?    @db.VarChar(255) @map("reference_source")
  description      String     @db.Text
  content          String     @db.Text
  thumbnail        String?    @db.Text
  readingTime      Int        @default(5)
  orderIndex       Int        @default(0)
  isPublished      Boolean    @default(true)
  createdBy        String     @db.Char(36)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  creator      MasterUser             @relation("MaterialCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  progress     UserMaterialProgress[]
  quizzes      Quiz[]
  certificates UserCertificate[]

  @@index([category])
  @@index([regionalLanguage])
  @@index([slug])
  @@index([isPublished])
  @@map("learning_materials")
}

model UserMaterialProgress {
  id          String    @id @db.Char(36)
  userId      String    @db.Char(36)
  materialId  String    @db.Char(36)
  status      String    @default("IN_PROGRESS")
  completedAt DateTime?
  xpEarned    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     MasterUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  material LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([userId, materialId])
  @@index([userId])
  @@index([materialId])
  @@map("user_material_progress")
}

model Quiz {
  id               String   @id @db.Char(36)
  title            String   @db.VarChar(200)
  description      String?  @db.Text
  category         Category
  regionalLanguage String?  @db.VarChar(50) @map("regional_language")
  referenceSource  String?  @db.VarChar(255) @map("reference_source")
  materialId       String?  @db.Char(36)
  timeLimit        Int      @default(30)
  passingScore     Int      @default(75)
  xpReward         Int      @default(50)
  isPublished      Boolean  @default(true)
  createdBy        String   @db.Char(36)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  material  LearningMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  creator   MasterUser        @relation("QuizCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([category])
  @@index([regionalLanguage])
  @@index([materialId])
  @@index([isPublished])
  @@map("quizzes")
}

model QuizQuestion {
  id                 String                     @id @db.Char(36)
  quizId             String                     @db.Char(36)
  question           String                     @db.Text
  options            String                     @db.Text
  correctIndex       Int
  explanation        String?                    @db.Text
  points             Int                        @default(10)
  orderIndex         Int                        @default(0)
  regionalLanguage   String?                    @db.VarChar(50) @map("regional_language")
  wiseSayingText     String?                    @db.Text @map("wise_saying_text")
  wiseSayingMeaning  String?                    @db.Text @map("wise_saying_meaning")
  referenceSource    String?                    @db.VarChar(255) @map("reference_source")
  audioUrl           String?                    @db.Text @map("audio_url")
  verificationStatus QuestionVerificationStatus @default(APPROVED) @map("verification_status")
  createdBy          String?                    @db.Char(36) @map("created_by")
  verifiedBy         String?                    @db.Char(36) @map("verified_by")
  reviewNotes        String?                    @db.Text @map("review_notes")
  createdAt          DateTime                   @default(now())

  quiz     Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  creator  MasterUser?         @relation("QuestionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  verifier MasterUser?         @relation("QuestionVerifier", fields: [verifiedBy], references: [id], onDelete: SetNull)
  answers  QuizAttemptAnswer[]

  @@index([quizId])
  @@index([quizId, verificationStatus])
  @@index([regionalLanguage])
  @@index([verificationStatus])
  @@index([createdBy])
  @@map("quiz_questions")
}

model QuizAttempt {
  id              String    @id @db.Char(36)
  userId          String    @db.Char(36)
  quizId          String    @db.Char(36)
  score           Int       @default(0)
  maxScore        Int       @default(0)
  passed          Boolean   @default(false)
  xpEarned        Int       @default(0)
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  timeSpent       Int       @default(0)
  violationCount  Int       @default(0) @map("violation_count")
  isAutoSubmitted Boolean   @default(false) @map("is_auto_submitted")

  user         MasterUser          @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz         Quiz                @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers      QuizAttemptAnswer[]
  certificates UserCertificate[]

  @@index([userId])
  @@index([quizId])
  @@index([userId, quizId])
  @@index([userId, completedAt])
  @@index([completedAt])
  @@index([quizId, score])
  @@index([score])
  @@map("quiz_attempts")
}

model QuizAttemptAnswer {
  id           String   @id @db.Char(36)
  attemptId    String   @db.Char(36)
  questionId   String   @db.Char(36)
  selectedIndex Int?
  isCorrect    Boolean  @default(false)
  pointsEarned Int      @default(0)
  answeredAt   DateTime @default(now())

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([attemptId])
  @@index([questionId])
  @@index([questionId, isCorrect])
  @@map("quiz_attempt_answers")
}

model MasterBadge {
  id          String   @id @db.Char(36)
  name        String   @db.VarChar(100)
  description String   @db.Text
  imageUrl    String   @db.Text
  category    String   @db.VarChar(50)
  xpThreshold Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  userBadges UserBadge[]

  @@index([category])
  @@index([xpThreshold])
  @@map("master_badges")
}

model UserBadge {
  id       String   @id @db.Char(36)
  userId   String   @db.Char(36)
  badgeId  String   @db.Char(36)
  earnedAt DateTime @default(now())

  user  MasterUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge MasterBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@map("user_badges")
}

model UserCertificate {
  id            String   @id @db.Char(36)
  userId        String   @db.Char(36)
  materialId    String   @db.Char(36)
  quizAttemptId String   @db.Char(36)
  certificateNo String   @unique @db.VarChar(50)
  issuedAt      DateTime @default(now())
  pdfUrl        String?  @db.Text

  user        MasterUser       @relation(fields: [userId], references: [id], onDelete: Cascade)
  material    LearningMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  quizAttempt QuizAttempt      @relation(fields: [quizAttemptId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([materialId])
  @@index([certificateNo])
  @@map("user_certificates")
}

model CharacterMatrix {
  id                  Int      @id @default(autoincrement()) @map("id_matrix")
  indonesianCharacter String   @db.VarChar(150) @map("indonesian_character")
  regionalLanguage    String   @db.VarChar(50) @map("regional_language")
  regionalTerm        String   @db.VarChar(200) @map("regional_term")
  characterSource     String   @db.Text @map("character_source")
  implementation      String   @db.Text @map("implementation")
  audioUrl            String?  @db.Text @map("audio_url")
  createdBy           String?  @db.Char(36) @map("created_by")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  creator MasterUser? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([regionalLanguage])
  @@index([indonesianCharacter])
  @@index([regionalLanguage, indonesianCharacter])
  @@map("character_matrices")
}

model RegionalModuleProgress {
  id               String   @id @db.Char(36)
  userId           String   @db.Char(36)
  regionalLanguage String   @db.VarChar(50) @map("regional_language")
  learnedCardIds   String   @db.Text @map("learned_card_ids")
  stage1Completed  Boolean  @default(false) @map("stage1_completed")
  stage2Completed  Boolean  @default(false) @map("stage2_completed")
  stage2Score      Int      @default(0) @map("stage2_score")
  stage3Completed  Boolean  @default(false) @map("stage3_completed")
  bestQuizScore    Int      @default(0) @map("best_quiz_score")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user MasterUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, regionalLanguage])
  @@index([userId])
  @@index([regionalLanguage])
  @@map("regional_module_progress")
}

model Sertifikat {
  id              String   @id @db.Char(36)
  nomorSertifikat String   @unique @db.VarChar(60) @map("nomor_sertifikat")
  userId          String   @db.Char(36)
  bahasaDaerah    String   @db.VarChar(50) @map("bahasa_daerah")
  tanggalTerbit   DateTime @default(now()) @map("tanggal_terbit")
  skorAkhir       Int      @default(0) @map("skor_akhir")

  user MasterUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, bahasaDaerah])
  @@index([userId])
  @@index([bahasaDaerah])
  @@index([bahasaDaerah, tanggalTerbit])
  @@map("sertifikat")
}
